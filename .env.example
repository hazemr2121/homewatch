# Copy to .env and fill in. Never commit .env.

TZ=Africa/Cairo

# Camera (Tapo: create a "Camera Account" in the Tapo app -> Advanced Settings)
FRIGATE_CAMERA_IP=192.168.1.60
FRIGATE_RTSP_USER=camuser
FRIGATE_RTSP_PASSWORD=change-me

# Where recordings/snapshots are stored on the host
MEDIA_PATH=./media

# Telegram: create a bot with @BotFather, get your chat id from /getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_CHAT_ID=123456789

# Comma-separated labels that trigger alerts: person,car,dog,cat
ALERT_LABELS=person
# How confident Frigate must be (0-1)
ALERT_MIN_SCORE=0.7
# At most one alert per camera+label in this window
ALERT_COOLDOWN_SECONDS=120

# Telegram commands (/snap, /cameras). Set to false if another app polls this bot.
ENABLE_COMMANDS=true
